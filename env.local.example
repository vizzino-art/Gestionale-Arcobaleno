# Copia questo file in .env.local (mai da caricare su GitHub — è già escluso
# dal .gitignore) e riempi i valori veri presi da Supabase e da Anthropic.

# Impostazioni progetto → API di Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Usata da /api/estrai-bolla per leggere le foto delle bolle con Claude.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
